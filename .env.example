SUB2API_MCP_HOST=127.0.0.1
SUB2API_MCP_PORT=5310
SUB2API_MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*","sub2api-scheduler-mcp:*"]
SUB2API_MCP_DATABASE_PATH=./data/sub2api-mcp.db
SUB2API_MCP_ACCESS_TOKENS=[{"name":"langbot","token":"replace-with-at-least-32-random-characters","scopes":["sub2api:read","sub2api:write","sub2api:admin"]}]
SUB2API_MCP_SUB2API_ADMIN_KEY=replace-me
SUB2API_MCP_SCHEDULER_ENABLED=false
SUB2API_MCP_PROBE_INTERVAL_SECONDS=60
SUB2API_MCP_SCHEDULER_LEASE_SECONDS=120
SUB2API_MCP_QUIET_HOURS_ENABLED=false
SUB2API_MCP_QUIET_HOURS_START=23:00
SUB2API_MCP_QUIET_HOURS_END=08:00
SUB2API_MCP_RECOVERY_ENABLED=false
# Set equal start/end values (for example 00:00/00:00) for a 24-hour window.
SUB2API_MCP_RECOVERY_WINDOW_START=02:00
SUB2API_MCP_RECOVERY_WINDOW_END=05:00
SUB2API_MCP_RECOVERY_MAX_ACCOUNTS_PER_RUN=5
SUB2API_MCP_CHANNEL_ACCOUNT_SWEEP_ENABLED=false
SUB2API_MCP_CHANNEL_ACCOUNT_SWEEP_MAX_ACCOUNTS=1000
SUB2API_MCP_LOG_ACCOUNT_GUARD_ENABLED=false
SUB2API_MCP_LOG_ERROR_THRESHOLD=3
SUB2API_MCP_LOG_SLOW_FIRST_TOKEN_THRESHOLD=3
SUB2API_MCP_SLOW_FIRST_TOKEN_MS=30000
SUB2API_MCP_LOG_WINDOW_MINUTES=30
SUB2API_MCP_LANGBOT_BASE_URL=
SUB2API_MCP_LANGBOT_API_KEY=
SUB2API_MCP_LANGBOT_ALLOW_HTTP=false
SUB2API_MCP_VIDEO_ENABLED=false
SUB2API_MCP_VIDEO_API_URL=https://h3.fzypod.com:9090/v1/video/generations
SUB2API_MCP_ACTOR_BRIDGE_ENABLED=false
SUB2API_MCP_ACTOR_BRIDGE_SECRET=
SUB2API_MCP_ACTOR_REPLAY_WINDOW_SECONDS=300
SUB2API_MCP_LOG_LEVEL=INFO
